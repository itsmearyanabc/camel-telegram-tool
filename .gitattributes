# Default: let git normalise text in the repo.
* text=auto

# These are consumed by Linux. CRLF endings make bash fail with
# "$'\r': command not found" and make systemd/nginx reject config lines,
# so force LF regardless of the platform they were authored on.
*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
Procfile        text eol=lf
Dockerfile      text eol=lf
docker-compose.yml text eol=lf
requirements.txt   text eol=lf
*.py            text eol=lf

# Never touch binaries.
*.db            binary
*.session       binary
*.png           binary
*.jpg           binary
